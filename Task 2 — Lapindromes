import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {

            String s = sc.next();

            int n = s.length();
            int[] count = new int[26];

            int mid = n / 2;

            for (int i = 0; i < mid; i++) {
                count[s.charAt(i) - 'a']++;
            }

            for (int i = (n + 1) / 2; i < n; i++) {
                count[s.charAt(i) - 'a']--;
            }

            boolean same = true;

            for (int x : count) {
                if (x != 0) {
                    same = false;
                    break;
                }
            }

            System.out.println(same ? "YES" : "NO");
        }
    }
}
